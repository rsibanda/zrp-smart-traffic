POSTGRES_USER=traffic_demo
POSTGRES_PASSWORD=replace_with_local_alphanumeric_password
POSTGRES_DB=traffic_demo
DATABASE_URL=postgresql://traffic_demo:replace_with_local_alphanumeric_password@localhost:5432/traffic_demo?schema=public
PORT=3000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
# Public deployed HTTPS frontend origin for ticket QRs. Never use localhost.
# PUBLIC_SITE_URL=https://your-site.netlify.app
TICKET_QR_EXPIRY_DAYS=30
# Private vehicle application attachments (server-enforced).
APPLICATION_FILE_LIMIT_MB=10
APPLICATION_ATTACHMENT_LIMIT=5
# Choose a local password of at least 12 characters before seeding. Never commit it.
DEMO_PASSWORD=
NODE_ENV=development
EVIDENCE_STORAGE=local
# Hosted free deployment uses EVIDENCE_STORAGE=s3 and backend-only variables:
# EVIDENCE_S3_BUCKET=traffic-evidence
# AWS_ENDPOINT_URL_S3=https://your-private-storage-endpoint
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Public backend origin without /api/v1. Omit to use the local Vite proxy.
VITE_API_URL=http://localhost:3000
# Production settings; secrets belong only in backend hosting configuration.
# CORS_ORIGIN=https://your-site.netlify.app
# EVIDENCE_DIRECTORY=/var/lib/traffic/evidence
# TRUST_PROXY=127.0.0.1/8,::1/128
