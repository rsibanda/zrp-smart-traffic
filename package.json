{
  "name": "zrp-smart-traffic",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/dashboard"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:dashboard": "npm run dev -w apps/dashboard",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint apps --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "test:integration": "npm run test:integration -w apps/api"
  },
  "overrides": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": {
      ".": "11.2.5",
      "multer": "2.3.0"
    },
    "@nestjs/testing": "11.2.5",
    "multer": "2.3.0",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "prisma": "6.12.0",
    "typescript": "~5.7.3",
    "eslint": "^8.57.1",
    "@typescript-eslint/parser": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "prettier": "^3.4.2"
  }
}
